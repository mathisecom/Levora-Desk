    "faq": {
      "type": "faq",
      "blocks": {
        "166442457738b23caf-0": {
          "type": "item",
          "settings": {
            "title": "Quelle est la garantie des produits LevoraDesk ?",
            "content": "<p>Tous nos bureaux LoveraDesk sont couverts par une garantie de 5 ans. Cette garantie couvre les défauts de fabrication et vous assure une utilisation fiable sur le long terme.</p>"
          }
        },
        "166442457738b23caf-1": {
          "type": "item",
          "disabled": true,
          "settings": {
            "title": "How long will it take to get my orders?",
            "content": "<p>It depends on where you are. Orders processed here will take 5-7 business days to arrive. Overseas deliveries can take anywhere from 7-16 days. Delivery details will be provided in your confirmation email.</p>"
          }
        },
        "166442457738b23caf-2": {
          "type": "item",
          "settings": {
            "title": "Est-ce que mes commandes peuvent être assemblées avant la livraison ?",
            "content": "<p>Nos produits sont livrés prêts à assembler, avec une notice claire pour vous guider étape par étape. L’assemblage est simple et ne nécessite pas de compétences particulières.</p>"
          }
        },
        "item_fwqrnM": {
          "type": "item",
          "settings": {
            "title": "Est-ce que vous livrez partout dans le monde ?",
            "content": "<p>Pour le moment, LoveraDesk livre principalement en France. Certaines destinations peuvent être disponibles selon les transporteurs. Les options de livraison sont indiquées au moment de la commande.</p>"
          }
        }
      },
