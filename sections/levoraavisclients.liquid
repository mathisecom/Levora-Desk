{% comment %}
  LevoraDesk - Slider avis clients avec images
{% endcomment %}

<section
  class="lv-reviews section-{{ section.id }}"
  style="
    --lv-bg: {{ section.settings.bg_color }};
    --lv-card-bg: {{ section.settings.card_bg }};
    --lv-border: {{ section.settings.border_color }};
    --lv-text: {{ section.settings.text_color }};
    --lv-muted: {{ section.settings.muted_color }};
    --lv-star-bg: {{ section.settings.star_bg }};
    --lv-star-color: {{ section.settings.star_color }};
    --lv-avatar-bg: {{ section.settings.avatar_bg }};
    --lv-avatar-text: {{ section.settings.avatar_text }};
    --lv-radius: {{ section.settings.card_radius }}px;
    --lv-gap: {{ section.settings.gap_desktop }}px;
    --lv-gap-mobile: {{ section.settings.gap_mobile }}px;
    --lv-items-desktop: {{ section.settings.items_desktop }};
    --lv-items-tablet: {{ section.settings.items_tablet }};
    --lv-items-mobile: {{ section.settings.items_mobile }};
    --lv-title-size: {{ section.settings.title_size }}px;
    --lv-text-size: {{ section.settings.review_size }}px;
    --lv-author-size: {{ section.settings.author_size }}px;
    --lv-date-size: {{ section.settings.date_size }}px;
    --lv-title-size-m: {{ section.settings.title_size_mobile }}px;
    --lv-text-size-m: {{ section.settings.review_size_mobile }}px;
    --lv-pad-y: {{ section.settings.padding_y }}px;
    --lv-pad-x: {{ section.settings.padding_x }}px;
    --lv-pad-y-m: {{ section.settings.padding_y_mobile }}px;
    --lv-pad-x-m: {{ section.settings.padding_x_mobile }}px;
  "
>
  <div class="lv-reviews__inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="lv-reviews__head">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="lv-reviews__subheading">
            {{ section.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="lv-reviews__slider-wrap">
      {% if section.settings.show_arrows %}
        <button class="lv-reviews__arrow lv-prev" type="button" aria-label="Avis précédent">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5L8 12L15 19"></path>
          </svg>
        </button>
      {% endif %}

      <div
        class="lv-reviews__track"
        data-lv-track
        data-autoplay="{{ section.settings.autoplay }}"
        data-speed="{{ section.settings.autoplay_speed }}"
      >
        {% for block in section.blocks %}
          <article class="lv-reviews__card" {{ block.shopify_attributes }}>
            {% if block.settings.review_image != blank %}
              <div class="lv-reviews__image-wrap">
                <img
                  src="{{ block.settings.review_image | image_url: width: 900 }}"
                  alt="{{ block.settings.review_image.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.review_image.width }}"
                  height="{{ block.settings.review_image.height }}"
                >
              </div>
            {% endif %}

            {% if block.settings.show_stars %}
              <div class="lv-reviews__stars" aria-label="{{ block.settings.rating }} étoiles">
                {% for i in (1..5) %}
                  <span class="lv-reviews__star {% if i > block.settings.rating %}is-empty{% endif %}">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 2.2l2.95 6.1 6.72.97-4.86 4.73 1.15 6.69L12 17.53 6.04 20.69 7.19 14 2.33 9.27l6.72-.97L12 2.2z"></path>
                    </svg>
                  </span>
                {% endfor %}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="lv-reviews__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.review != blank %}
              <div class="lv-reviews__text">
                {{ block.settings.review }}
              </div>
            {% endif %}

            {% if block.settings.show_author %}
              <div class="lv-reviews__bottom">
                <div class="lv-reviews__line"></div>

                <div class="lv-reviews__author-row">
                  {% if block.settings.avatar != blank %}
                    <div class="lv-reviews__avatar has-image">
                      <img
                        src="{{ block.settings.avatar | image_url: width: 120 }}"
                        alt="{{ block.settings.avatar.alt | escape }}"
                        loading="lazy"
                      >
                    </div>
                  {% else %}
                    <div class="lv-reviews__avatar">
                      {{ block.settings.initial }}
                    </div>
                  {% endif %}

                  <div class="lv-reviews__author-info">
                    {% if block.settings.author != blank %}
                      <div class="lv-reviews__author">
                        {{ block.settings.author }}
                      </div>
                    {% endif %}

                    {% if block.settings.date != blank %}
                      <div class="lv-reviews__date">
                        {{ block.settings.date }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button class="lv-reviews__arrow lv-next" type="button" aria-label="Avis suivant">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5L16 12L9 19"></path>
          </svg>
        </button>
      {% endif %}
    </div>

    {% if section.settings.show_dots %}
      <div class="lv-reviews__controls">
        <div class="lv-reviews__dots" data-lv-dots></div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: var(--lv-bg);
    padding: var(--lv-pad-y) var(--lv-pad-x);
    overflow: hidden;
  }

  .section-{{ section.id }} .lv-reviews__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .section-{{ section.id }} .lv-reviews__head {
    text-align: center;
    margin-bottom: {{ section.settings.heading_margin }}px;
  }

  .section-{{ section.id }} .lv-reviews__head h2 {
    margin: 0;
    color: var(--lv-text);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    font-weight: {{ section.settings.heading_weight }};
  }

  .section-{{ section.id }} .lv-reviews__subheading {
    margin-top: 12px;
    color: var(--lv-muted);
    font-size: {{ section.settings.subheading_size }}px;
  }

  .section-{{ section.id }} .lv-reviews__subheading p {
    margin: 0;
  }

  .section-{{ section.id }} .lv-reviews__slider-wrap {
    position: relative;
  }

  .section-{{ section.id }} .lv-reviews__track {
    display: flex;
    gap: var(--lv-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .section-{{ section.id }} .lv-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .section-{{ section.id }} .lv-reviews__card {
    flex: 0 0 calc(
      (100% - (var(--lv-gap) * (var(--lv-items-desktop) - 1))) / var(--lv-items-desktop)
    );
    background: var(--lv-card-bg);
    border: {{ section.settings.border_width }}px solid var(--lv-border);
    border-radius: var(--lv-radius);
    padding: {{ section.settings.card_padding_y }}px {{ section.settings.card_padding_x }}px;
    min-height: {{ section.settings.card_height }}px;
    scroll-snap-align: start;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    color: var(--lv-text);
  }

  .section-{{ section.id }} .lv-reviews__image-wrap {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    margin-bottom: {{ section.settings.image_margin }}px;
    background: #f3f3f3;
  }

  .section-{{ section.id }} .lv-reviews__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  .section-{{ section.id }} .lv-reviews__stars {
    display: flex;
    align-items: center;
    gap: {{ section.settings.star_gap }}px;
    margin-bottom: {{ section.settings.stars_margin }}px;
  }

  .section-{{ section.id }} .lv-reviews__star {
    width: {{ section.settings.star_size }}px;
    height: {{ section.settings.star_size }}px;
    background: var(--lv-star-bg);
    color: var(--lv-star-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .lv-reviews__star.is-empty {
    opacity: 0.3;
  }

  .section-{{ section.id }} .lv-reviews__star svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .section-{{ section.id }} .lv-reviews__title {
    margin: 0 0 {{ section.settings.title_margin }}px;
    color: var(--lv-text);
    font-size: var(--lv-title-size);
    line-height: 1.18;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: -0.03em;
  }

  .section-{{ section.id }} .lv-reviews__text {
    color: var(--lv-text);
    font-size: var(--lv-text-size);
    line-height: 1.45;
    font-weight: {{ section.settings.review_weight }};
  }

  .section-{{ section.id }} .lv-reviews__text p {
    margin: 0;
  }

  .section-{{ section.id }} .lv-reviews__bottom {
    margin-top: auto;
    padding-top: {{ section.settings.author_top_space }}px;
  }

  .section-{{ section.id }} .lv-reviews__line {
    height: 1px;
    background: var(--lv-border);
    margin-bottom: {{ section.settings.author_gap }}px;
  }

  .section-{{ section.id }} .lv-reviews__author-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .section-{{ section.id }} .lv-reviews__avatar {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    background: var(--lv-avatar-bg);
    color: var(--lv-avatar-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.avatar_font_size }}px;
    font-weight: 700;
    overflow: hidden;
    flex-shrink: 0;
  }

  .section-{{ section.id }} .lv-reviews__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-{{ section.id }} .lv-reviews__author {
    color: var(--lv-text);
    font-size: var(--lv-author-size);
    font-weight: 700;
    line-height: 1.1;
  }

  .section-{{ section.id }} .lv-reviews__date {
    color: var(--lv-muted);
    font-size: var(--lv-date-size);
    line-height: 1.2;
    margin-top: 3px;
  }

  .section-{{ section.id }} .lv-reviews__arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: 999px;
    border: {{ section.settings.arrow_border_width }}px solid {{ section.settings.arrow_border }};
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 8px 22px rgba(0,0,0,0.08);
  }

  .section-{{ section.id }} .lv-reviews__arrow svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .section-{{ section.id }} .lv-reviews__arrow.lv-prev {
    left: -{{ section.settings.arrow_offset }}px;
  }

  .section-{{ section.id }} .lv-reviews__arrow.lv-next {
    right: -{{ section.settings.arrow_offset }}px;
  }

  .section-{{ section.id }} .lv-reviews__controls {
    display: flex;
    justify-content: center;
    margin-top: {{ section.settings.dots_margin }}px;
  }

  .section-{{ section.id }} .lv-reviews__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .section-{{ section.id }} .lv-reviews__dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: 999px;
    border: 0;
    background: {{ section.settings.dot_color }};
    opacity: 0.28;
    padding: 0;
    cursor: pointer;
    transition: 0.25s ease;
  }

  .section-{{ section.id }} .lv-reviews__dot.is-active {
    opacity: 1;
    width: {{ section.settings.dot_active_width }}px;
  }

  @media screen and (max-width: 989px) {
    .section-{{ section.id }} .lv-reviews__card {
      flex-basis: calc(
        (100% - (var(--lv-gap) * (var(--lv-items-tablet) - 1))) / var(--lv-items-tablet)
      );
    }

    .section-{{ section.id }} .lv-reviews__arrow.lv-prev {
      left: 8px;
    }

    .section-{{ section.id }} .lv-reviews__arrow.lv-next {
      right: 8px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding: var(--lv-pad-y-m) var(--lv-pad-x-m);
    }

    .section-{{ section.id }} .lv-reviews__head {
      margin-bottom: {{ section.settings.heading_margin_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__head h2 {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__subheading {
      font-size: {{ section.settings.subheading_size_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__track {
      gap: var(--lv-gap-mobile);
    }

    .section-{{ section.id }} .lv-reviews__card {
      flex-basis: calc(
        (100% - (var(--lv-gap-mobile) * (var(--lv-items-mobile) - 1))) / var(--lv-items-mobile)
      );
      padding: {{ section.settings.card_padding_y_mobile }}px {{ section.settings.card_padding_x_mobile }}px;
      min-height: {{ section.settings.card_height_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__image-wrap {
      height: {{ section.settings.image_height_mobile }}px;
      margin-bottom: {{ section.settings.image_margin_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__star {
      width: {{ section.settings.star_size_mobile }}px;
      height: {{ section.settings.star_size_mobile }}px;
      padding: 3px;
    }

    .section-{{ section.id }} .lv-reviews__stars {
      margin-bottom: {{ section.settings.stars_margin_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__title {
      font-size: var(--lv-title-size-m);
      margin-bottom: {{ section.settings.title_margin_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__text {
      font-size: var(--lv-text-size-m);
    }

    .section-{{ section.id }} .lv-reviews__avatar {
      width: {{ section.settings.avatar_size_mobile }}px;
      height: {{ section.settings.avatar_size_mobile }}px;
      font-size: {{ section.settings.avatar_font_size_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__author {
      font-size: {{ section.settings.author_size_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__date {
      font-size: {{ section.settings.date_size_mobile }}px;
    }

    .section-{{ section.id }} .lv-reviews__arrow {
      width: {{ section.settings.arrow_size_mobile }}px;
      height: {{ section.settings.arrow_size_mobile }}px;
    }

    {% unless section.settings.show_arrows_mobile %}
      .section-{{ section.id }} .lv-reviews__arrow {
        display: none;
      }
    {% endunless %}
  }
</style>

<script>
  (function() {
    function initReviewsSlider(section) {
      if (!section) return;

      const track = section.querySelector('[data-lv-track]');
      const dotsWrap = section.querySelector('[data-lv-dots]');
      const prev = section.querySelector('.lv-prev');
      const next = section.querySelector('.lv-next');

      if (!track) return;

      const cards = Array.from(track.children);
      let autoplayTimer = null;

      function getGap() {
        const style = window.getComputedStyle(track);
        return parseFloat(style.columnGap || style.gap) || 0;
      }

      function getStep() {
        const firstCard = cards[0];
        if (!firstCard) return 0;
        return firstCard.getBoundingClientRect().width + getGap();
      }

      function getActiveIndex() {
        const step = getStep();
        if (!step) return 0;
        return Math.round(track.scrollLeft / step);
      }

      function goTo(index) {
        const step = getStep();
        track.scrollTo({
          left: step * index,
          behavior: 'smooth'
        });
      }

      function updateDots() {
        if (!dotsWrap) return;

        const activeIndex = getActiveIndex();
        const dots = dotsWrap.querySelectorAll('.lv-reviews__dot');

        dots.forEach(function(dot, index) {
          dot.classList.toggle('is-active', index === activeIndex);
        });
      }

      function createDots() {
        if (!dotsWrap) return;

        dotsWrap.innerHTML = '';

        cards.forEach(function(_, index) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'lv-reviews__dot';
          dot.setAttribute('aria-label', 'Aller à l’avis ' + (index + 1));

          if (index === 0) {
            dot.classList.add('is-active');
          }

          dot.addEventListener('click', function() {
            goTo(index);
          });

          dotsWrap.appendChild(dot);
        });
      }

      function startAutoplay() {
        const autoplay = track.dataset.autoplay === 'true';
        const speed = parseInt(track.dataset.speed, 10) || 4000;

        if (!autoplay) return;

        stopAutoplay();

        autoplayTimer = setInterval(function() {
          const step = getStep();
          const maxScroll = track.scrollWidth - track.clientWidth;

          if (track.scrollLeft + step >= maxScroll - 5) {
            track.scrollTo({
              left: 0,
              behavior: 'smooth'
            });
          } else {
            track.scrollBy({
              left: step,
              behavior: 'smooth'
            });
          }
        }, speed);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      if (prev) {
        prev.addEventListener('click', function() {
          track.scrollBy({
            left: -getStep(),
            behavior: 'smooth'
          });
        });
      }

      if (next) {
        next.addEventListener('click', function() {
          track.scrollBy({
            left: getStep(),
            behavior: 'smooth'
          });
        });
      }

      track.addEventListener('scroll', function() {
        window.requestAnimationFrame(updateDots);
      });

      track.addEventListener('mouseenter', stopAutoplay);
      track.addEventListener('mouseleave', startAutoplay);
      track.addEventListener('touchstart', stopAutoplay, { passive: true });
      track.addEventListener('touchend', startAutoplay, { passive: true });

      createDots();
      updateDots();
      startAutoplay();
    }

    function initAllReviewsSliders() {
      document.querySelectorAll('.lv-reviews').forEach(function(section) {
        if (section.dataset.lvReady === 'true') return;
        section.dataset.lvReady = 'true';
        initReviewsSlider(section);
      });
    }

    document.addEventListener('DOMContentLoaded', initAllReviewsSliders);

    document.addEventListener('shopify:section:load', function(event) {
      const section = event.target.querySelector('.lv-reviews');
      if (section) {
        section.dataset.lvReady = 'false';
        initReviewsSlider(section);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Avis slider image",
  "settings": [
    {
      "type": "header",
      "content": "Titre section"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils nous font confiance"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "<p></p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Titre PC",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Titre mobile",
      "min": 16,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Graisse titre",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra-bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Sous-titre PC",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Sous-titre mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_margin",
      "label": "Marge titre PC",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_margin_mobile",
      "label": "Marge titre mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Afficher flèches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Flèches mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Afficher points",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Défilement auto",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Vitesse auto",
      "min": 2500,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "default": 4500
    },
    {
      "type": "range",
      "id": "items_desktop",
      "label": "Cartes PC",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "items_tablet",
      "label": "Cartes tablette",
