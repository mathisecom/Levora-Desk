{% comment %}
  LevoraDesk - Slider cartes réassurance
{% endcomment %}

<section
  class="ld-card-slider section-{{ section.id }}"
  style="
    --ld-bg: {{ section.settings.bg_color }};
    --ld-card-bg: {{ section.settings.card_bg }};
    --ld-text: {{ section.settings.text_color }};
    --ld-muted: {{ section.settings.muted_color }};
    --ld-icon: {{ section.settings.icon_color }};
    --ld-radius: {{ section.settings.radius }}px;
    --ld-gap: {{ section.settings.gap }}px;
    --ld-gap-mobile: {{ section.settings.gap_mobile }}px;
    --ld-pad-y: {{ section.settings.padding_y }}px;
    --ld-pad-x: {{ section.settings.padding_x }}px;
    --ld-card-pad-y: {{ section.settings.card_padding_y }}px;
    --ld-card-pad-x: {{ section.settings.card_padding_x }}px;
    --ld-title-size: {{ section.settings.title_size }}px;
    --ld-text-size: {{ section.settings.text_size }}px;
    --ld-icon-size: {{ section.settings.icon_size }}px;
    --ld-title-size-m: {{ section.settings.title_size_mobile }}px;
    --ld-text-size-m: {{ section.settings.text_size_mobile }}px;
    --ld-icon-size-m: {{ section.settings.icon_size_mobile }}px;
    --ld-items-desktop: {{ section.settings.items_desktop }};
    --ld-items-tablet: {{ section.settings.items_tablet }};
    --ld-items-mobile: {{ section.settings.items_mobile }};
  "
>
  <div class="ld-card-slider__inner">
    {% if section.settings.heading != blank %}
      <div class="ld-card-slider__heading">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    <div class="ld-card-slider__wrap">
      {% if section.settings.show_arrows %}
        <button class="ld-card-slider__arrow ld-prev" type="button" aria-label="Précédent">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5L8 12L15 19"/>
          </svg>
        </button>
      {% endif %}

      <div
        class="ld-card-slider__track"
        data-slider-track
        data-autoplay="{{ section.settings.autoplay }}"
        data-speed="{{ section.settings.autoplay_speed }}"
      >
        {% for block in section.blocks %}
          <article class="ld-card-slider__card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != 'none' %}
              <div class="ld-card-slider__icon">
                {% case block.settings.icon %}
                  {% when 'truck' %}
                    <svg viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M5 17h24v17H5z"/>
                      <path d="M29 22h7l6 6v6H29z"/>
                      <path d="M11 38a4 4 0 1 0 0-8a4 4 0 0 0 0 8z"/>
                      <path d="M36 38a4 4 0 1 0 0-8a4 4 0 0 0 0 8z"/>
                      <path d="M10 13h12"/>
                      <path d="M7 9h12"/>
                    </svg>

                  {% when 'return' %}
                    <svg viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M14 6h20v36H14z"/>
                      <path d="M20 6v9l4-3l4 3V6"/>
                      <path d="M29 28H17"/>
                      <path d="M21 23l-5 5l5 5"/>
                    </svg>

                  {% when 'shield' %}
                    <svg viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M24 5l15 6v10c0 10-6.5 18-15 22C15.5 39 9 31 9 21V11z"/>
                      <path d="M18 24l4 4l8-9"/>
                    </svg>

                  {% when 'card' %}
                    <svg viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M7 14h28v20H7z"/>
                      <path d="M7 20h28"/>
                      <path d="M12 28h10"/>
                      <path d="M31 28l4 4l7-9"/>
                      <path d="M35 18l7 3v9c0 5-3 9-7 11c-4-2-7-6-7-11v-9z"/>
                    </svg>

                  {% when 'box' %}
                    <svg viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M8 15l16-8l16 8v18l-16 8L8 33z"/>
                      <path d="M8 15l16 8l16-8"/>
                      <path d="M24 23v18"/>
                    </svg>

                  {% when 'check' %}
                    <svg viewBox="0 0 48 48" aria-hidden="true">
                      <path d="M24 42a18 18 0 1 0 0-36a18 18 0 0 0 0 36z"/>
                      <path d="M16 24l5 5l11-12"/>
                    </svg>
                {% endcase %}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="ld-card-slider__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="ld-card-slider__text">
                {{ block.settings.text }}
              </div>
            {% endif %}

            {% if block.settings.badge != blank %}
              <div class="ld-card-slider__badge">
                <img
                  src="{{ block.settings.badge | image_url: width: 160 }}"
                  alt="{{ block.settings.badge.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.badge.width }}"
                  height="{{ block.settings.badge.height }}"
                >
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button class="ld-card-slider__arrow ld-next" type="button" aria-label="Suivant">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5L16 12L9 19"/>
          </svg>
        </button>
      {% endif %}
    </div>

    {% if section.settings.show_dots %}
      <div class="ld-card-slider__dots" data-slider-dots></div>
    {% endif %}
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: var(--ld-bg);
    padding: var(--ld-pad-y) var(--ld-pad-x);
    overflow: hidden;
  }

  .section-{{ section.id }} .ld-card-slider__inner {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .ld-card-slider__heading {
    color: var(--ld-text);
    text-align: center;
    margin-bottom: 28px;
  }

  .section-{{ section.id }} .ld-card-slider__heading p,
  .section-{{ section.id }} .ld-card-slider__text p {
    margin: 0;
  }

  .section-{{ section.id }} .ld-card-slider__wrap {
    position: relative;
  }

  .section-{{ section.id }} .ld-card-slider__track {
    display: flex;
    gap: var(--ld-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .section-{{ section.id }} .ld-card-slider__track::-webkit-scrollbar {
    display: none;
  }

  .section-{{ section.id }} .ld-card-slider__card {
    flex: 0 0 calc(
      (100% - (var(--ld-gap) * (var(--ld-items-desktop) - 1))) / var(--ld-items-desktop)
    );
    min-height: {{ section.settings.card_height }}px;
    background: var(--ld-card-bg);
    border-radius: var(--ld-radius);
    padding: var(--ld-card-pad-y) var(--ld-card-pad-x);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--ld-text);
    text-align: center;
    box-sizing: border-box;
  }

  .section-{{ section.id }} .ld-card-slider__icon {
    width: var(--ld-icon-size);
    height: var(--ld-icon-size);
    margin-bottom: 28px;
    color: var(--ld-icon);
  }

  .section-{{ section.id }} .ld-card-slider__icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .section-{{ section.id }} .ld-card-slider__title {
    margin: 0 0 16px;
    color: var(--ld-text);
    font-size: var(--ld-title-size);
    line-height: 1.15;
    font-weight: {{ section.settings.title_weight }};
  }

  .section-{{ section.id }} .ld-card-slider__text {
    color: var(--ld-muted);
    font-size: var(--ld-text-size);
    line-height: 1.45;
    font-weight: {{ section.settings.text_weight }};
    max-width: 430px;
  }

  .section-{{ section.id }} .ld-card-slider__badge {
    margin-top: 22px;
    display: flex;
    justify-content: center;
  }

  .section-{{ section.id }} .ld-card-slider__badge img {
    max-width: {{ section.settings.badge_width }}px;
    height: auto;
    display: block;
  }

  .section-{{ section.id }} .ld-card-slider__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 0;
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 8px 25px rgba(0,0,0,0.08);
  }

  .section-{{ section.id }} .ld-card-slider__arrow svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .section-{{ section.id }} .ld-card-slider__arrow.ld-prev {
    left: -22px;
  }

  .section-{{ section.id }} .ld-card-slider__arrow.ld-next {
    right: -22px;
  }

  .section-{{ section.id }} .ld-card-slider__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }

  .section-{{ section.id }} .ld-card-slider__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 0;
    background: {{ section.settings.dot_color }};
    opacity: 0.35;
    padding: 0;
    cursor: pointer;
  }

  .section-{{ section.id }} .ld-card-slider__dot.is-active {
    opacity: 1;
    width: 22px;
  }

  @media screen and (max-width: 989px) {
    .section-{{ section.id }} .ld-card-slider__card {
      flex-basis: calc(
        (100% - (var(--ld-gap) * (var(--ld-items-tablet) - 1))) / var(--ld-items-tablet)
      );
    }

    .section-{{ section.id }} .ld-card-slider__arrow.ld-prev {
      left: 8px;
    }

    .section-{{ section.id }} .ld-card-slider__arrow.ld-next {
      right: 8px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding: {{ section.settings.padding_y_mobile }}px {{ section.settings.padding_x_mobile }}px;
    }

    .section-{{ section.id }} .ld-card-slider__track {
      gap: var(--ld-gap-mobile);
      padding-bottom: 2px;
    }

    .section-{{ section.id }} .ld-card-slider__card {
      flex-basis: calc(
        (100% - (var(--ld-gap-mobile) * (var(--ld-items-mobile) - 1))) / var(--ld-items-mobile)
      );
      min-height: {{ section.settings.card_height_mobile }}px;
      padding: {{ section.settings.card_padding_y_mobile }}px {{ section.settings.card_padding_x_mobile }}px;
    }

    .section-{{ section.id }} .ld-card-slider__icon {
      width: var(--ld-icon-size-m);
      height: var(--ld-icon-size-m);
      margin-bottom: 22px;
    }

    .section-{{ section.id }} .ld-card-slider__title {
      font-size: var(--ld-title-size-m);
      margin-bottom: 12px;
    }

    .section-{{ section.id }} .ld-card-slider__text {
      font-size: var(--ld-text-size-m);
      max-width: 300px;
    }

    .section-{{ section.id }} .ld-card-slider__badge {
      margin-top: 18px;
    }

    .section-{{ section.id }} .ld-card-slider__badge img {
      max-width: {{ section.settings.badge_width_mobile }}px;
    }

    .section-{{ section.id }} .ld-card-slider__arrow {
      width: 38px;
      height: 38px;
    }

    {% unless section.settings.show_arrows_mobile %}
      .section-{{ section.id }} .ld-card-slider__arrow {
        display: none;
      }
    {% endunless %}
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('[data-slider-track]');
    const dotsWrap = section.querySelector('[data-slider-dots]');
    const prev = section.querySelector('.ld-prev');
    const next = section.querySelector('.ld-next');

    if (!track) return;

    const cards = Array.from(track.children);
    let autoplayTimer = null;

    function getStep() {
      const firstCard = cards[0];
      if (!firstCard) return 0;
      const gap = parseFloat(window.getComputedStyle(track).columnGap || window.getComputedStyle(track).gap) || 0;
      return firstCard.getBoundingClientRect().width + gap;
    }

    function getActiveIndex() {
      const step = getStep();
      if (!step) return 0;
      return Math.round(track.scrollLeft / step);
    }

    function goTo(index) {
      const step = getStep();
      track.scrollTo({
        left: step * index,
        behavior: 'smooth'
      });
    }

    function updateDots() {
      if (!dotsWrap) return;
      const index = getActiveIndex();
      const dots = dotsWrap.querySelectorAll('.ld-card-slider__dot');

      dots.forEach(function(dot, i) {
        dot.classList.toggle('is-active', i === index);
      });
    }

    if (dotsWrap) {
      dotsWrap.innerHTML = '';

      cards.forEach(function(_, index) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'ld-card-slider__dot';
        dot.setAttribute('aria-label', 'Aller à la carte ' + (index + 1));

        if (index === 0) {
          dot.classList.add('is-active');
        }

        dot.addEventListener('click', function() {
          goTo(index);
        });

        dotsWrap.appendChild(dot);
      });
    }

    if (prev) {
      prev.addEventListener('click', function() {
        const step = getStep();
        track.scrollBy({
          left: -step,
          behavior: 'smooth'
        });
      });
    }

    if (next) {
      next.addEventListener('click', function() {
        const step = getStep();
        track.scrollBy({
          left: step,
          behavior: 'smooth'
        });
      });
    }

    track.addEventListener('scroll', function() {
      window.requestAnimationFrame(updateDots);
    });

    function startAutoplay() {
      const autoplay = track.dataset.autoplay === 'true';
      const speed = parseInt(track.dataset.speed, 10) || 4000;

      if (!autoplay) return;

      autoplayTimer = setInterval(function() {
        const step = getStep();
        const maxScroll = track.scrollWidth - track.clientWidth;

        if (track.scrollLeft + step >= maxScroll - 5) {
          track.scrollTo({
            left: 0,
            behavior: 'smooth'
          });
        } else {
          track.scrollBy({
            left: step,
            behavior: 'smooth'
          });
        }
      }, speed);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
      }
    }

    track.addEventListener('mouseenter', stopAutoplay);
    track.addEventListener('mouseleave', startAutoplay);
    track.addEventListener('touchstart', stopAutoplay, { passive: true });
    track.addEventListener('touchend', startAutoplay, { passive: true });

    startAutoplay();
    updateDots();
  });
</script>

{% schema %}
{
  "name": "Cartes réassurance",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Titre",
      "default": "<p></p>"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Afficher flèches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "Flèches mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Afficher points",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Vitesse auto",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "range",
      "id": "items_desktop",
      "label": "Cartes PC",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "items_tablet",
      "label": "Cartes tablette",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "items_mobile",
      "label": "Cartes mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond section",
      "default": "#eeeeeb"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Fond carte",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte titre",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texte paragraphe",
      "default": "#5f5f5f"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Couleur icône",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Fond flèche",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Couleur flèche",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Couleur points",
      "default": "#171717"
    },
    {
      "type": "header",
